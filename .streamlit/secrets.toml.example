# Copy into Streamlit Community Cloud: App settings → Secrets.
# For local runs you can instead copy this file to .streamlit/secrets.toml (git-ignored) or use .env.
GROQ_API_KEY = "gsk_your_groq_api_key_here"
TAVILY_API_KEY = "tvly-your_tavily_api_key_here"

# Optional
GROQ_MODEL = "llama-3.3-70b-versatile"
MAX_RESEARCH_RUNS_PER_SESSION = 5   # protects your API quota on a public link; 0 = unlimited
